# PostgreSQL Connection String (e.g. from Neon.tech, Supabase, Railway, Aiven, or Local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ashtavinayak_db?schema=public"

# Secret key used for signing JWT authentication tokens (use a long, secure random string in production)
